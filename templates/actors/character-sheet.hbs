                Lancer un Jet de Survie
            </button>

        </section>


        <!-- ============================================= -->
        <!-- RADIATION                                     -->
        <!-- ============================================= -->

        <section class="metro-character-survival-panel">

            <div class="metro-item-section-header metro-character-survival-section-header">
                <span class="metro-red-star" aria-hidden="true">★</span>
                <span>Radiation</span>
            </div>

            <div class="metro-character-survival-radiation">

                <label>
                    <span>Doses</span>
                    <input
                        type="number"
                        name="system.radiation.doses"
                        value="{{character.survival.radiation.doses}}"
                        min="0"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    />
                </label>

                <label>
                    <span>Doses permanentes</span>
                    <input
                        type="number"
                        name="system.radiation.permanent"
                        value="{{character.survival.radiation.permanent}}"
                        min="0"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    />
                </label>

                <button
                    type="button"
                    class="metro-character-survival-radiation-roll"
