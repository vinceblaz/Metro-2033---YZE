                <div class="metro-character-survival-status-effects metro-character-survival-states-grid">

                    {{#each character.survival.statusEffects}}

                        <label
                            class="metro-character-survival-condition metro-character-survival-status-effect"
                        >
                            <input
                                type="checkbox"
                                data-status-id="{{id}}"
                                {{#if active}}checked{{/if}}
                                {{#unless @root.isGM}}disabled{{/unless}}
                            />
                            {{#if img}}
                                <img
                                    class="metro-character-survival-status-effect-icon"
                                    src="{{img}}"
                                    alt=""
                                />
                            {{/if}}
                            <span>{{name}}</span>
                        </label>

                    {{/each}}

                </div>

            {{/if}}

        </section>


        <!-- ============================================= -->
        <!-- BLESSURES CRITIQUES / TRAUMAS PSYCHOLOGIQUES  -->
        <!-- ============================================= -->

        <section class="metro-character-survival-panel">

            <div class="metro-item-section-header metro-character-survival-section-header">
                <span class="metro-red-star" aria-hidden="true">★</span>
                <span>Blessures critiques / Traumas psychologiques</span>
            </div>

            {{#if character.survival.afflictions.length}}

                <table class="metro-character-survival-affliction-table">

                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Type</th>
                            <th aria-label="Actions"></th>
                        </tr>
                    </thead>

                    <tbody>

                        {{#each character.survival.afflictions}}

                            <tr
                                class="metro-character-survival-affliction-row metro-character-embedded-item"
                                data-item-id="{{id}}"
                                data-item-type="{{type}}"
                            >

                                <td class="metro-character-survival-affliction-cell-name">

                                    <button
                                        class="metro-character-survival-link"
                                        type="button"
                                        data-item-id="{{id}}"
                                        title="Ouvrir la fiche"
                                    >
                                        <img
                                            class="metro-character-survival-affliction-image"
                                            src="{{img}}"
                                            alt="{{name}}"
                                        >
                                        <span>{{name}}</span>
                                    </button>

                                </td>

                                <td class="metro-character-survival-affliction-cell-type">
                                    {{typeLabel}}
                                    {{#if fatal}}
                                        <span class="metro-character-survival-affliction-fatal">
                                            Fatale
                                        </span>
                                    {{/if}}

                                    {{#if canDeathRoll}}
                                        <button
                                            type="button"
                                            class="metro-character-survival-death-roll"
                                            data-item-id="{{id}}"
                                            title="Jet de Trépas"
                                        >
                                            Jet de Trépas
                                            {{#if deathRolls}}
                                                ({{deathRolls}})
                                            {{/if}}
                                        </button>
                                    {{/if}}
                                </td>

                                <td class="metro-character-survival-affliction-cell-actions">
                                    <button
                                        class="metro-character-item-actions"
                                        type="button"
                                        data-item-id="{{id}}"
                                        data-item-type="{{type}}"
                                        title="Actions"
                                        aria-label="Actions pour {{name}}"
                                        aria-haspopup="menu"
                                    >
                                        ⋮
                                    </button>
                                </td>

                            </tr>

                        {{/each}}

                    </tbody>

                </table>

            {{else}}

                <div class="metro-character-survival-empty">
                    Aucune blessure critique ni trauma psychologique en cours.
                </div>

            {{/if}}

        </section>

    </section>


    <!-- ===================================================== -->
    <!-- BIOGRAPHIE                                            -->
    <!-- ===================================================== -->

    <section
        class="metro-character-biography metro-character-tab-panel"
        data-character-tab-panel="biography"
        role="tabpanel"
        hidden
    >

        <!-- ============================================= -->
        <!-- IDENTITÉ                                      -->
        <!-- ============================================= -->

        <section class="metro-character-biography-panel">

            <div class="metro-item-section-header metro-character-biography-section-header">
                <span class="metro-red-star" aria-hidden="true">★</span>
                <span>Identité</span>
            </div>

            <!--
                Âge et Genre sont déjà éditables dans l'en-tête
                de la fiche (visible sur tous les onglets) :
                system.identity.age / system.identity.gender.
                Ils ne sont volontairement pas dupliqués ici,
                un même "name" sur deux champs de formulaire
                casserait la soumission.
            -->

            <label class="metro-character-biography-textarea-field">
                <span>Apparence</span>
                <textarea
                    name="system.identity.appearance"
                    rows="3"
                    placeholder="Visage, corps, vêtements..."
                    {{#unless editable}}disabled{{/unless}}
                >{{character.biography.identity.appearance}}</textarea>
            </label>

        </section>


        <!-- ============================================= -->
        <!-- AFFILIATIONS                                  -->
        <!-- ============================================= -->

        <section class="metro-character-biography-panel">

            <div class="metro-item-section-header metro-character-biography-section-header">
                <span class="metro-red-star" aria-hidden="true">★</span>
                <span>Affiliations</span>
            </div>

            <div class="metro-character-biography-affiliations-grid">

                <div class="metro-character-doc-ref-field">

                    <span class="metro-character-doc-ref-label">
                        Faction (sensibilité idéologique)
                    </span>

                    <div
                        class="metro-character-doc-ref"
                        data-uuid-field="system.affiliations.faction"
                        data-allowed-types="faction"
                    >

                        {{#if character.biography.affiliations.faction.resolved}}

                            <img
                                class="metro-character-doc-ref-img"
                                src="{{character.biography.affiliations.faction.img}}"
                                alt=""
                            />
                            <span class="metro-character-doc-ref-name">
                                {{character.biography.affiliations.faction.name}}
                            </span>

                            <button
                                type="button"
                                class="metro-character-doc-ref-open"
                                data-uuid-field="system.affiliations.faction"
                                title="Ouvrir la fiche"
                            >
                                Ouvrir
                            </button>

                            {{#if editable}}
                                <button
                                    type="button"
                                    class="metro-character-doc-ref-clear"
                                    data-uuid-field="system.affiliations.faction"
                                    title="Retirer"
                                >
                                    ✕
                                </button>
                            {{/if}}

                        {{else if character.biography.affiliations.faction.uuid}}

                            <span class="metro-character-doc-ref-placeholder metro-character-doc-ref-error">
                                Document introuvable ({{character.biography.affiliations.faction.uuid}})
                            </span>

                            {{#if editable}}
                                <button
                                    type="button"
                                    class="metro-character-doc-ref-clear"
                                    data-uuid-field="system.affiliations.faction"
                                    title="Retirer"
                                >
                                    ✕
                                </button>
                            {{/if}}

                        {{else}}

                            <span class="metro-character-doc-ref-placeholder">
                                Glisser-déposer une Faction ici
                            </span>

                        {{/if}}

                    </div>

                </div>


                <div class="metro-character-doc-ref-field">

                    <span class="metro-character-doc-ref-label">
                        Station (lieu de vie)
                    </span>

                    <div
                        class="metro-character-doc-ref"
                        data-uuid-field="system.affiliations.community"
                        data-allowed-types="station"
                    >

                        {{#if character.biography.affiliations.community.resolved}}

                            <img
                                class="metro-character-doc-ref-img"
                                src="{{character.biography.affiliations.community.img}}"
                                alt=""
                            />
                            <span class="metro-character-doc-ref-name">
                                {{character.biography.affiliations.community.name}}
                            </span>

                            <button
                                type="button"
                                class="metro-character-doc-ref-open"
                                data-uuid-field="system.affiliations.community"
                                title="Ouvrir la fiche"
                            >
                                Ouvrir
                            </button>

                            {{#if editable}}
                                <button
                                    type="button"
                                    class="metro-character-doc-ref-clear"
                                    data-uuid-field="system.affiliations.community"
                                    title="Retirer"
                                >
                                    ✕
                                </button>
                            {{/if}}

                        {{else if character.biography.affiliations.community.uuid}}

                            <span class="metro-character-doc-ref-placeholder metro-character-doc-ref-error">
                                Document introuvable ({{character.biography.affiliations.community.uuid}})
                            </span>

                            {{#if editable}}
                                <button
                                    type="button"
                                    class="metro-character-doc-ref-clear"
                                    data-uuid-field="system.affiliations.community"
                                    title="Retirer"
                                >
                                    ✕
                                </button>
                            {{/if}}

                        {{else}}

                            <span class="metro-character-doc-ref-placeholder">
                                Glisser-déposer une Station ici
                            </span>

                        {{/if}}

                    </div>

                </div>

            </div>

        </section>


        <!-- ============================================= -->
        <!-- HISTOIRE                                      -->
        <!-- ============================================= -->

        <section class="metro-character-biography-panel">

            <div class="metro-item-section-header metro-character-biography-section-header">
                <span class="metro-red-star" aria-hidden="true">★</span>
                <span>Histoire</span>
            </div>

            <textarea
                name="system.identity.biography"
                rows="8"
                class="metro-character-biography-history"
                placeholder="Histoire du personnage..."
                {{#unless editable}}disabled{{/unless}}
            >{{character.biography.identity.biography}}</textarea>

        </section>


        <!-- ============================================= -->
        <!-- FIERTÉ / HONTE                                -->
        <!-- ============================================= -->

        <section class="metro-character-biography-panel">

            <div class="metro-item-section-header metro-character-biography-section-header">
                <span class="metro-red-star" aria-hidden="true">★</span>
                <span>Fierté / Honte</span>
            </div>

            <div class="metro-character-biography-pride-shame">

                <label class="metro-character-biography-textarea-field">
                    <span>Fierté</span>
                    <textarea
                        name="system.narrative.pride.description"
                        rows="3"
                        placeholder="Ce qui rend votre personnage unique..."
                        {{#unless editable}}disabled{{/unless}}
                    >{{character.biography.pride.description}}</textarea>
                </label>

                <label class="metro-character-biography-pride-used">
                    <input
                        type="checkbox"
                        name="system.narrative.pride.used"
                        {{checked character.biography.pride.used}}
                        {{#unless editable}}disabled{{/unless}}
                    />
                    <span>
                        Fierté déjà utilisée cette session
                        (1 réussite automatique/session, livre p.172)
                    </span>
                </label>

                <label class="metro-character-biography-textarea-field">
                    <span>Honte</span>
                    <textarea
                        name="system.narrative.shame"
                        rows="3"
                        placeholder="Un événement passé qui vous marque ou vous menace..."
                        {{#unless editable}}disabled{{/unless}}
                    >{{character.biography.shame}}</textarea>
                </label>

            </div>

        </section>


        <!-- ============================================= -->
        <!-- LIENS AVEC LES PJ / PNJ                       -->
        <!-- ============================================= -->

        <section class="metro-character-biography-panel">

            <div class="metro-item-section-header metro-character-biography-section-header">
                <span class="metro-red-star" aria-hidden="true">★</span>
                <span>Liens</span>

                {{#if editable}}
                    <button
                        type="button"
                        class="metro-character-biography-list-add"
                        data-action="addListRow"
                        data-list="relationships"
                    >
                        + Ajouter
                    </button>
                {{/if}}

            </div>

            {{#unless character.biography.relationships.length}}

                <p class="metro-character-biography-list-empty">
                    Aucun lien renseigné.
                </p>

            {{/unless}}

            {{#each character.biography.relationships}}

                <div class="metro-character-biography-list-row">

                    <div
                        class="metro-character-doc-ref metro-character-doc-ref-compact"
                        data-uuid-field="system.narrative.relationships.{{index}}.actor"
                        data-allowed-types="character,npc,creature,vehicle"
                    >

                        {{#if actor.resolved}}

                            <img
                                class="metro-character-doc-ref-img"
                                src="{{actor.img}}"
                                alt=""
                            />
                            <span class="metro-character-doc-ref-name">
                                {{actor.name}}
                            </span>

                        {{else if actor.uuid}}

                            <span class="metro-character-doc-ref-placeholder metro-character-doc-ref-error">
                                Introuvable
                            </span>

                        {{else}}

                            <span class="metro-character-doc-ref-placeholder">
                                Glisser-déposer un Acteur ici
                            </span>

                        {{/if}}

                    </div>

                    <input
                        type="text"
                        name="system.narrative.relationships.{{index}}.type"
                        value="{{type}}"
                        list="metro-character-relationship-type-suggestions"
                        placeholder="À protéger, Rival..."
                        {{#unless @root.editable}}disabled{{/unless}}
                    />

                    <input
                        type="text"
                        name="system.narrative.relationships.{{index}}.description"
                        value="{{description}}"
                        placeholder="Description"
                        {{#unless @root.editable}}disabled{{/unless}}
                    />

                    {{#if @root.editable}}
                        <button
                            type="button"
                            class="metro-character-biography-list-remove"
                            data-action="removeListRow"
                            data-list="relationships"
                            data-index="{{index}}"
                            title="Retirer ce lien"
                        >
                            ✕
                        </button>
                    {{/if}}

                </div>

            {{/each}}

            <datalist id="metro-character-relationship-type-suggestions">
                <option value="À protéger"></option>
                <option value="Rival / Ennemi"></option>
                <option value="Pote"></option>
                <option value="Camarade"></option>
            </datalist>

        </section>


        {{#if isGM}}

            <section class="metro-character-biography-panel metro-gm-section">

                <div class="metro-item-section-header metro-character-biography-section-header">
                    <span class="metro-red-star" aria-hidden="true">★</span>
                    <span>Notes du MJ</span>
                </div>

                <textarea
                    name="system.narrative.gmNotes"
                    rows="6"
                    placeholder="Notes privées du MJ..."
                    {{#unless editable}}disabled{{/unless}}
                >{{character.biography.gmNotes}}</textarea>

            </section>

        {{/if}}

    </section>

</div>