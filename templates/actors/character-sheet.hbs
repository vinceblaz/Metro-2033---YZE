                                                    {{#unless canFire}}disabled{{/unless}}
                                                >
                                                    Rafale
                                                </button>
                                            {{/if}}
                                        {{/if}}
                                    </div>
                                </td>
                            </tr>
                        {{/each}}
                    </tbody>
                </table>
            {{else}}

                <div class="metro-character-combat-empty">
                    Aucune arme équipée.
                </div>

            {{/if}}
        </section>


        <!-- ================================================= -->
        <!-- PROTECTIONS ÉQUIPÉES                              -->
        <!-- ================================================= -->
        <section class="metro-character-combat-panel metro-character-protections">
