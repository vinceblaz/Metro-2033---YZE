<div class="metro-character-sheet-form">

    <header class="metro-character-header">

        <!-- ================================================= -->
        <!-- ZONE SUPÉRIEURE : PORTRAIT + IDENTITÉ + STRESS   -->
        <!-- ================================================= -->

        <div class="metro-character-header-main">
 
            <!-- Portrait -->
            <div class="metro-character-portrait">

                <img
                    class="metro-character-image"
                    src="{{actor.img}}"
                    alt="{{actor.name}}"
                    data-action="editImage"
                    data-edit="img"
                    title="Cliquer pour modifier le portrait"
                >

            </div>


            <!-- Identité -->
            <div class="metro-character-identity">

                <!-- Nom -->
                <div class="metro-character-name-row">

                    <input
                        class="metro-character-name"
                        type="text"
                        name="name"
                        value="{{actor.name}}"
                        placeholder="Nom du personnage"
                        {{#unless editable}}disabled{{/unless}}
                    >

                </div>


                <!-- Genre / Âge / Stress -->
                <div class="metro-character-identity-summary">

                    <div class="metro-character-identity-fields">

                        <!-- Genre -->
                        <label class="metro-character-gender-field">

                            <span class="metro-label-with-star metro-character-field-header">

                                <span
                                    class="metro-red-star"
                                    aria-hidden="true"
                                >
                                    ★
                                </span>

                                <span>
                                    Genre
                                </span>

                            </span>

                            <input
                                type="text"
                                name="system.identity.gender"
                                value="{{system.identity.gender}}"
                                placeholder="Genre"
                                {{#unless editable}}disabled{{/unless}}
                            >

                        </label>


                        <!-- Âge -->
                        <label class="metro-character-age-field">

                            <span class="metro-label-with-star metro-character-field-header">

                                <span
                                    class="metro-red-star"
                                    aria-hidden="true"
                                >
                                    ★
                                </span>

                                <span>
                                    Âge
                                </span>

                            </span>

                            <input
                                type="number"
                                name="system.identity.age"
                                value="{{system.identity.age}}"
                                min="0"
                                step="1"
                                {{#unless editable}}disabled{{/unless}}
                            >

                        </label>

                    </div>


                    <!-- ========================================= -->
                    <!-- STRESS - LECTURE SEULE                    -->
                    <!-- ========================================= -->

                    <section
                        class="metro-character-stress"
                        data-stress="{{system.stress.dice}}"
                        aria-label="Stress : {{system.stress.dice}} sur 5"
                        title="Stress : {{system.stress.dice}} sur 5"
                    >

                        <div class="metro-character-stress-title">

                            <span class="metro-label-with-star metro-character-field-header">

                                <span
                                    class="metro-red-star"
                                    aria-hidden="true"
                                >
                                    ★
                                </span>

                                <span>
                                    Stress
                                </span>

                            </span>

                        </div>


                        <div
                            class="metro-character-stress-pips"
                            aria-hidden="true"
                        >

                            <span class="metro-character-stress-pip"></span>
                            <span class="metro-character-stress-pip"></span>
                            <span class="metro-character-stress-pip"></span>
                            <span class="metro-character-stress-pip"></span>
                            <span class="metro-character-stress-pip"></span>

                        </div>

                    </section>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- ATTRIBUTS                                         -->
        <!-- ================================================= -->

        <section class="metro-character-attributes">

            <!-- Vigueur -->
            <div class="metro-character-attribute">

                <div class="metro-character-attribute-title metro-character-field-header">

                    <span
                        class="metro-red-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                    <span>
                        Vigueur
                    </span>
                </div>

                <div class="metro-character-attribute-values">

                    <input
                        type="number"
                        name="system.attributes.vigor.value"
                        value="{{system.attributes.vigor.value}}"
                        min="0"
                        max="5"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    >

                    <span>/</span>

                    <input
                        type="number"
                        name="system.attributes.vigor.max"
                        value="{{system.attributes.vigor.max}}"
                        min="1"
                        max="5"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    >

                </div>

                <button
                    class="metro-character-attribute-roll"
                    type="button"
                    data-attribute="vigor"
                    title="Jet de Vigueur"
                    aria-label="Jet de Vigueur"
                >
                    <i
                        class="fa-solid fa-dice-d6"
                        aria-hidden="true"
                    ></i>
                </button>

            </div>


            <!-- Agilité -->
            <div class="metro-character-attribute">

                <div class="metro-character-attribute-title metro-character-field-header">

                    <span
                        class="metro-red-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                    <span>
                        Agilité
                    </span>

                </div>

                <div class="metro-character-attribute-values">

                    <input
                        type="number"
                        name="system.attributes.agility.value"
                        value="{{system.attributes.agility.value}}"
                        min="0"
                        max="5"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    >

                    <span>/</span>

                    <input
                        type="number"
                        name="system.attributes.agility.max"
                        value="{{system.attributes.agility.max}}"
                        min="1"
                        max="5"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    >

                </div>

                <button
                    class="metro-character-attribute-roll"
                    type="button"
                    data-attribute="agility"
                    title="Jet d'Agilité"
                    aria-label="Jet d'Agilité"
                >
                    <i
                        class="fa-solid fa-dice-d6"
                        aria-hidden="true"
                    ></i>
                </button>

            </div>


            <!-- Esprit -->
            <div class="metro-character-attribute">

                <div class="metro-character-attribute-title metro-character-field-header">

                    <span
                        class="metro-red-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                    <span>
                        Esprit
                    </span>

                </div>

                <div class="metro-character-attribute-values">

                    <input
                        type="number"
                        name="system.attributes.spirit.value"
                        value="{{system.attributes.spirit.value}}"
                        min="0"
                        max="5"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    >

                    <span>/</span>

                    <input
                        type="number"
                        name="system.attributes.spirit.max"
                        value="{{system.attributes.spirit.max}}"
                        min="1"
                        max="5"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    >

                </div>

                <button
                    class="metro-character-attribute-roll"
                    type="button"
                    data-attribute="spirit"
                    title="Jet d'Esprit"
                    aria-label="Jet d'Esprit"
                >
                    <i
                        class="fa-solid fa-dice-d6"
                        aria-hidden="true"
                    ></i>
                </button>

            </div>


            <!-- Empathie -->
            <div class="metro-character-attribute">

                <div class="metro-character-attribute-title metro-character-field-header">

                    <span
                        class="metro-red-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                    <span>
                        Empathie
                    </span>

                </div>

                <div class="metro-character-attribute-values">

                    <input
                        type="number"
                        name="system.attributes.empathy.value"
                        value="{{system.attributes.empathy.value}}"
                        min="0"
                        max="5"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    >

                    <span>/</span>

                    <input
                        type="number"
                        name="system.attributes.empathy.max"
                        value="{{system.attributes.empathy.max}}"
                        min="1"
                        max="5"
                        step="1"
                        {{#unless editable}}disabled{{/unless}}
                    >

                </div>

                <button
                    class="metro-character-attribute-roll"
                    type="button"
                    data-attribute="empathy"
                    title="Jet d'Empathie"
                    aria-label="Jet d'Empathie"
                >
                    <i
                        class="fa-solid fa-dice-d6"
                        aria-hidden="true"
                    ></i>
                </button>

            </div>

        </section>

    </header>

    <!-- ===================================================== -->
    <!-- ONGLETS                                               -->
    <!-- ===================================================== -->

    <nav
        class="metro-character-tabs"
        role="tablist"
        aria-label="Sections de la fiche"
    >

        <button
            class="metro-character-tab is-active"
            type="button"
            role="tab"
            data-character-tab="skills"
            aria-selected="true"
        >
            <span
                class="metro-character-tab-star"
                aria-hidden="true"
            >
                ★
            </span>

            <span>
                Compétences
            </span>
        </button>


        <button
            class="metro-character-tab"
            type="button"
            role="tab"
            data-character-tab="combat"
            aria-selected="false"
        >
            <span
                class="metro-character-tab-star"
                aria-hidden="true"
            >
                ★
            </span>

            <span>
                Combat
            </span>
        </button>


        <button
            class="metro-character-tab"
            type="button"
            role="tab"
            data-character-tab="equipment"
            aria-selected="false"
        >
            <span
                class="metro-character-tab-star"
                aria-hidden="true"
            >
                ★
            </span>

            <span>
                Équipement
            </span>
        </button>


        <button
            class="metro-character-tab"
            type="button"
            role="tab"
            data-character-tab="survival"
            aria-selected="false"
        >
            <span
                class="metro-character-tab-star"
                aria-hidden="true"
            >
                ★
            </span>

            <span>
                Survie
            </span>
        </button>


        <button
            class="metro-character-tab"
            type="button"
            role="tab"
            data-character-tab="biography"
            aria-selected="false"
        >
            <span
                class="metro-character-tab-star"
                aria-hidden="true"
            >
                ★
            </span>

            <span>
                Biographie
            </span>
        </button>

    </nav>


    <!-- ===================================================== -->
    <!-- COMPÉTENCES                                           -->
    <!-- ===================================================== -->

    <section
        class="metro-character-skills metro-character-tab-panel is-active"
        data-character-tab-panel="skills"
        role="tabpanel"
    >


        <div class="metro-character-skill-groups">

            {{#each character.skillGroups}}

                <section
                    class="metro-character-skill-group"
                    data-attribute="{{id}}"
                >

                    <header class="metro-character-skill-group-header">

                        <span
                            class="metro-red-star"
                            aria-hidden="true"
                        >
                            ★
                        </span>

                        <span>
                            {{label}}
                        </span>

                    </header>


                    <div class="metro-character-skill-list">

                        {{#each skills}}

                            <div
                                class="metro-character-skill-row"
                                data-skill="{{id}}"
                            >

                                <!-- ========================= -->
                                <!-- NOM DE COMPÉTENCE         -->
                                <!-- ========================= -->

                                <div class="metro-character-skill-name">

                                    <span>
                                        {{label}}
                                    </span>


                                    {{#if progression.isArchetypeSkill}}

                                        <span
                                            class="metro-character-skill-archetype"
                                            title="Compétence d'archétype"
                                            aria-label="Compétence d'archétype"
                                        >
                                            ★
                                        </span>

                                    {{/if}}

                                </div>


                                <!-- ========================= -->
                                <!-- VALEUR                    -->
                                <!-- ========================= -->

                                <input
                                    class="metro-character-skill-value"
                                    type="number"
                                    name="system.skills.{{id}}"
                                    value="{{value}}"
                                    min="0"
                                    max="5"
                                    step="1"
                                    {{#unless @root.editable}}disabled{{/unless}}
                                >


                                <!-- ========================= -->
                                <!-- TEST                      -->
                                <!-- ========================= -->

                                <button
                                    class="metro-character-skill-roll"
                                    type="button"
                                    data-skill="{{id}}"
                                    title="Jet de {{label}}"
                                    aria-label="Jet de {{label}}"
                                >
                                    <i
                                        class="fa-solid fa-dice-d6"
                                        aria-hidden="true"
                                    ></i>
                                </button>


                                <!-- ========================= -->
                                <!-- PROGRESSION               -->
                                <!-- ========================= -->

                                <div class="metro-character-skill-progression">

                                    {{#if progression.requiresGMApproval}}

                                        <span
                                            class="metro-character-skill-gm-approval"
                                            title="Le passage du niveau 0 au niveau 1 nécessite l'autorisation du MJ."
                                        >
                                            MJ
                                        </span>

                                    {{/if}}


                                    {{#if progression.cost}}

                                        <span class="metro-character-skill-xp-cost">
                                            {{progression.cost}} XP
                                        </span>

                                    {{/if}}


                                    <button
                                        class="metro-character-skill-xp"
                                        type="button"
                                        data-skill="{{id}}"
                                        title="Augmenter cette compétence d'un niveau"
                                        {{#unless progression.canImprove}}disabled{{/unless}}
                                    >
                                        +1
                                    </button>

                                </div>

                            </div>

                        {{/each}}

                    </div>

                </section>

            {{/each}}

        </div>

        <!-- ===================================================== -->
        <!-- TALENTS                                               -->
        <!-- ===================================================== -->

        <section class="metro-character-talents">

            <table class="metro-character-talent-table">

                <thead>

                    <tr>

                        <th class="metro-character-talent-column-name">

                            <div class="metro-character-talent-heading">
                                <span
                                    class="metro-red-star"
                                    aria-hidden="true"
                                >
                                    ★
                                </span>
                                <span>
                                    Talents
                                </span>

                                <button
                                    class="metro-character-talent-sort"
                                    type="button"
                                    title="Inverser l'ordre alphabétique des Talents"
                                    aria-label="Trier les Talents"
                                >
                                    <span
                                        class="metro-character-talent-sort-indicator"
                                        aria-hidden="true"
                                    >
                                        {{#if @root.character.talentSortAscending}}
                                            ↑
                                        {{else}}
                                            ↓
                                        {{/if}}
                                    </span>
                                </button>

                            </div>

                        </th>

                        <th class="metro-character-talent-column-level">
                            Niveau
                        </th>

                        <th
                            class="metro-character-talent-column-actions"
                            aria-label="Actions"
                        ></th>                        

                    </tr>

                </thead>


                <tbody>

                    {{#each character.talents}}

                        <tr
                            class="metro-character-talent-row metro-character-embedded-item"
                            data-item-id="{{id}}"
                            data-item-type="talent"
                        >

                            <td class="metro-character-talent-cell-name">

                                <button
                                    class="metro-character-talent-link"
                                    type="button"
                                    data-talent-id="{{id}}"
                                    title="Ouvrir le Talent"
                                >

                                    <img
                                        class="metro-character-talent-image"
                                        src="{{img}}"
                                        alt="{{name}}"
                                    >

                                    <span class="metro-character-talent-name">
                                        {{name}}
                                    </span>

                                </button>

                            </td>


                            <td class="metro-character-talent-cell-level">

                                <div class="metro-character-talent-progression">

                                    <span class="metro-character-talent-level">
                                        {{levelLabel}}
                                    </span>


                                    {{#unless isMaxLevel}}

                                        <button
                                            class="metro-character-skill-xp metro-character-talent-improve"
                                            type="button"
                                            data-talent-id="{{id}}"
                                            title="Augmenter {{name}} d'un niveau — 5 XP"
                                            aria-label="Augmenter {{name}} d'un niveau pour 5 XP"
                                            {{#unless @root.editable}}disabled{{/unless}}
                                        >
                                            +1
                                        </button>

                                    {{/unless}}

                                </div>

                            </td>

                            <td class="metro-character-talent-cell-actions">

                                <button
                                    class="metro-character-item-actions"
                                    type="button"
                                    data-item-id="{{id}}"
                                    data-item-type="talent"
                                    title="Actions"
                                    aria-label="Actions pour {{name}}"
                                    aria-haspopup="menu"
                                >
                                    ⋮
                                </button>

                            </td>                            

                        </tr>

                    {{/each}}

                </tbody>

            </table>

        </section>

        <!-- ===================================================== -->
        <!-- ARCHÉTYPE + EXPÉRIENCE                               -->
        <!-- ===================================================== -->

        <section class="metro-character-skills-summary">

            <!-- ============================================= -->
            <!-- ARCHÉTYPE                                     -->
            <!-- ============================================= -->

            <div class="metro-character-skills-archetype">

                <div class="metro-label-with-star metro-character-field-header">
                    <span class="metro-label-star">★</span>
                    <span>Archétype</span>
                </div>


                {{#if character.identity.archetype.hasItem}}

                    <div
                        class="metro-character-archetype-item metro-character-embedded-item"
                        data-item-id="{{character.identity.archetype.itemId}}"
                        data-item-type="archetype"
                    >

                        <div class="metro-character-archetype-item-main">

                            <div class="metro-character-archetype-item-content">

                                <button
                                    type="button"
                                    class="metro-character-archetype-link"
                                    data-action="openEmbeddedItem"
                                    data-item-id="{{character.identity.archetype.itemId}}"
                                    title="Ouvrir l'Archétype"
                                    aria-label="Ouvrir l'Archétype {{character.identity.archetype.name}}"
                                >

                                    {{#if character.identity.archetype.img}}

                                        <img
                                            class="metro-character-archetype-item-image"
                                            src="{{character.identity.archetype.img}}"
                                            alt="{{character.identity.archetype.name}}"
                                        >

                                    {{/if}}

                                    <span class="metro-character-archetype-name">
                                        {{character.identity.archetype.label}}
                                    </span>

                                </button>


                                {{#if character.identity.archetype.attributeLabel}}

                                    <div class="metro-character-archetype-detail">

                                        <span class="metro-character-archetype-detail-label">
                                            Attribut
                                        </span>

                                        <strong>
                                            {{character.identity.archetype.attributeLabel}}
                                        </strong>

                                    </div>

                                {{/if}}


                                {{#if character.identity.archetype.skills.length}}

                                    <div class="metro-character-archetype-detail">

                                        <span class="metro-character-archetype-detail-label">
                                            Compétences
                                        </span>

                                        <span class="metro-character-archetype-skills">

                                            {{#each character.identity.archetype.skills}}

                                                <span class="metro-character-archetype-skill">
                                                    {{label}}
                                                </span>

                                            {{/each}}

                                        </span>

                                    </div>

                                {{/if}}

                            </div>

                        </div>


                        <button
                            type="button"
                            class="metro-character-item-actions"
                            data-item-id="{{character.identity.archetype.itemId}}"
                            data-item-type="archetype"
                            title="Actions"
                            aria-label="Actions pour {{character.identity.archetype.name}}"
                        >
                            ⋮
                        </button>

                    </div>


                {{else}}

                    <div class="metro-character-archetype-empty">
                        Aucun Archétype
                    </div>

                {{/if}}

            </div>


            <!-- ============================================= -->
            <!-- EXPÉRIENCE                                    -->
            <!-- ============================================= -->

            <section class="metro-character-xp">

                <div class="metro-character-xp-title">

                    <span class="metro-label-with-star metro-character-field-header">

                        <span
                            class="metro-red-star"
                            aria-hidden="true"
                        >
                            ★
                        </span>

                        <span>
                            Expérience
                        </span>

                    </span>

                </div>


                <div class="metro-character-xp-values">

                    <label>

                        <span>
                            Actuel
                        </span>

                        <input
                            class="metro-character-xp-available-input"
                            type="number"
                            name="system.progression.xp.available"
                            value="{{system.progression.xp.available}}"
                            min="0"
                            step="1"
                            {{#unless editable}}disabled{{/unless}}
                        >

                    </label>


                    <label>

                        <span>
                            Dépensée
                        </span>

                        <span class="metro-character-xp-readonly">
                            {{system.progression.xp.spent}}
                        </span>

                    </label>


                    <label>

                        <span>
                            Total
                        </span>

                        <input
                            class="metro-character-xp-total-input"
                            type="number"
                            name="xpTotal"
                            value="{{character.xp.total}}"
                            min="{{character.xp.spent}}"
                            step="1"
                            {{#unless editable}}disabled{{/unless}}
                        >

                    </label>

                </div>

            </section>

        </section>

        <!-- ================================================= -->
        <!-- RAPPEL : CHOIX POSSIBLES DES AFFLICTIONS          -->
        <!-- ================================================= -->

        <section class="metro-choices-reminder">

            <h3 class="metro-choices-reminder-title">
                Rappel — Choix possibles des afflictions
            </h3>

            <p class="metro-choices-reminder-intro">
                Chaque affliction (« 1 » d'un jet forcé, ou d'un dé de Stress) doit être attribuée à l'un de ces choix :
            </p>

            <ul class="metro-choices-reminder-list">
                {{#each character.reminders.afflictions}}
                    <li>
                        <strong>{{label}}</strong>
                        — {{detail}}
                    </li>
                {{/each}}
            </ul>

        </section>

    </section>

    <!-- ===================================================== -->
    <!-- COMBAT                                                -->
    <!-- ===================================================== -->

    <section
        class="metro-character-combat metro-character-tab-panel"
        data-character-tab-panel="combat"
        role="tabpanel"
        hidden
    >

        <!-- ================================================= -->
        <!-- ARMES ÉQUIPÉES                                    -->
        <!-- ================================================= -->

        <section class="metro-character-combat-panel metro-character-weapons">

            {{#if character.combat.hasWeapons}}
                <table class="metro-character-talent-table">
                    <thead>
                        <tr>
                            <th class="metro-character-talent-column-name">
                                <div class="metro-character-talent-heading">
                                    <span
                                        class="metro-red-star"
                                        aria-hidden="true"
                                    >
                                        ★
                                    </span>
                                    <span>
                                        Arme(s) équipée(s)
                                    </span>
                                </div>

                            </th>

                            <th class="metro-character-talent-column-level">
                                Portée
                            </th>

                            <th class="metro-character-talent-column-xp">
                                Bonus
                            </th>

                            <th class="metro-character-talent-column-xp">
                                Dégâts
                            </th>

                            <th class="metro-character-talent-column-xp">
                                Munitions
                            </th>

                            <th
                                class="metro-character-talent-column-actions"
                                aria-label="Actions"
                            ></th>                        
                        </tr>
                    </thead>

                    <tbody>
                        {{#each character.combat.weapons}}

                            <tr
                                class="metro-character-talent-row metro-character-embedded-item"
                                data-item-id="{{id}}"
                                data-item-type="weapon"
                            >
                                <td class="metro-character-talent-cell-name">
                                <!-- ============================= -->
                                <!-- Identité                         -->
                                <!-- ============================= -->                                    
                                    <div class="metro-character-combat-item-identity">
                                        <img
                                            class="metro-character-talent-image"
                                            src="{{img}}"
                                            alt="{{name}}"
                                        >
                                        <span
                                            class="metro-character-combat-item-link"
                                            data-item-id="{{id}}"
