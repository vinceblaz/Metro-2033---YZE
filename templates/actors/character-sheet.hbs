                    <i class="fa-solid fa-bed" aria-hidden="true"></i> Repos
                </button>

                {{#if character.survival.secondWindOwned}}
                    <button
                        type="button"
                        class="metro-character-survival-second-wind"
                        {{#unless character.survival.secondWindAvailable}}hidden{{/unless}}
                        title="Talent Second souffle : jet d'ENDURANCE (dés de compétence uniquement, non forçable) ; 1 point de VIGUEUR récupéré par réussite"
                    >
                        Second souffle
                    </button>
                {{/if}}

            </div>

        </section>


        <!-- ============================================= -->
        <!-- RÉSERVES : EAU / NOURRITURE / ÉNERGIE         -->
        <!-- ============================================= -->

        <section class="metro-character-survival-panel">

            <div class="metro-item-section-header metro-character-survival-section-header">
                <span class="metro-red-star" aria-hidden="true">★</span>
                <span>Réserves</span>
            </div>

            <div class="metro-character-survival-reserves">

                {{#each character.survival.reserves}}

                    <div class="metro-character-survival-reserve">

