                            type="number"
                            name="system.survival.{{key}}"
                            value="{{level}}"
                            min="0"
                            max="10"
                            step="1"
                            {{#unless @root.editable}}disabled{{/unless}}
                        />

                        <button
                            type="button"
                            class="metro-character-survival-reserve-roll"
                            data-resource="{{key}}"
