            <div class="metro-character-defense-value metro-character-defense-total">

                <span class="metro-character-defense-label">
                    <span
                        class="metro-red-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                    <span>
                        Protection totale
                    </span>
                </span>

                <strong class="metro-character-defense-score">
                    {{character.combat.defense.totalProtection}}
                </strong>

            </div>

        </section>

        <!-- ================================================= -->
        <!-- RAPPEL : ÉCLATS ET RÉUSSITES DE BLOCAGE           -->
        <!-- ================================================= -->

        <section class="metro-choices-reminder">

