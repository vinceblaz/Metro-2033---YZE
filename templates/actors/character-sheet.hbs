    <!-- ===================================================== -->
    <!-- ÉQUIPEMENT                                            -->
    <!-- ===================================================== -->

    <section
        class="metro-character-equipment metro-character-tab-panel"
        data-character-tab-panel="equipment"
        role="tabpanel"
        hidden
    >

        <!-- ============================================= -->
        <!-- SYNTHÈSE : ENCOMBREMENT + MONNAIE             -->
        <!-- ============================================= -->

        <section class="metro-character-equipment-summary">

            <div
                class="metro-character-equipment-encumbrance
                    {{#if character.equipment.encumbrance.criticallyOverloaded}}
                        is-critical
                    {{else if character.equipment.encumbrance.overloaded}}
                        is-overloaded
                    {{/if}}"
            >
                <span class="metro-character-equipment-encumbrance-label">
                    <span
                        class="metro-red-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                    <span>
                        Encombrement
                    </span>
                </span>

                <strong class="metro-character-equipment-encumbrance-value">
                    {{character.equipment.encumbrance.totalWeight}}
                    /
                    {{character.equipment.encumbrance.capacity}}
                </strong>

                {{#if character.equipment.encumbrance.overloaded}}
                    <span class="metro-character-equipment-encumbrance-hint">
                        {{#if character.equipment.encumbrance.criticallyOverloaded}}
                            Encombrement critique (max {{character.equipment.encumbrance.criticalCapacity}}) : jet d'ENDURANCE requis pour courir.
                        {{else}}
                            Trop encombré : jet d'ENDURANCE requis pour courir.
                        {{/if}}
                    </span>
                {{/if}}
            </div>


            <!--
                Lecture seule : les réserves de survie ne se
                modifient que depuis l'onglet Survie. Affichées
                ici uniquement pour expliquer leur contribution
                à l'encombrement total ci-dessus.
            -->
            <div class="metro-character-equipment-reserves">

                <span class="metro-character-equipment-encumbrance-label">
                    <span class="metro-red-star" aria-hidden="true">★</span>
                    <span>Réserves</span>
                </span>

                <div class="metro-character-equipment-reserves-list">

                    <span>Eau {{character.equipment.reserves.water.level}}/10 ({{character.equipment.reserves.water.weight}})</span>
                    <span>Nourriture {{character.equipment.reserves.food.level}}/10 ({{character.equipment.reserves.food.weight}})</span>
                    <span>Énergie {{character.equipment.reserves.energy.level}}/10 ({{character.equipment.reserves.energy.weight}})</span>

                </div>

            </div>


            <label class="metro-character-equipment-currency">

                <span>
                    <span
                        class="metro-red-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                    <span>
                        Poulettes
                    </span>
                </span>

                <input
                    type="number"
                    name="system.currency.militaryBullets"
                    value="{{character.equipment.currency.militaryBullets}}"
                    min="0"
                    step="1"
                    {{#unless editable}}disabled{{/unless}}
                />

            </label>

        </section>


        <!-- ============================================= -->
        <!-- SECTIONS PAR TYPE D'OBJET                     -->
        <!-- ============================================= -->

        {{#each character.equipment.sections}}

            <section class="metro-character-equipment-panel">

                <div class="metro-item-section-header metro-character-equipment-section-header">
                    <span
                        class="metro-red-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                    <span>
                        {{label}}
                    </span>
                </div>

                {{#if items.length}}

                    <table class="metro-character-equipment-table">

                        <thead>
                            <tr>
                                <th class="metro-character-equipment-column-name">
                                    Nom
                                </th>
                                <th class="metro-character-equipment-column-weight">
                                    Poids
                                </th>
                                <th class="metro-character-equipment-column-info">
                                    État / Quantité
                                </th>
                                <th class="metro-character-equipment-column-equipped">
                                    Équipée
                                </th>
                                <th
                                    class="metro-character-equipment-column-actions"
                                    aria-label="Actions"
                                ></th>
                            </tr>
                        </thead>

                        <tbody>

                            {{#each items}}

                                <tr
                                    class="metro-character-equipment-row metro-character-embedded-item"
                                    data-item-id="{{id}}"
                                    data-item-type="{{type}}"
                                >

                                    <td class="metro-character-equipment-cell-name">

                                        <button
                                            class="metro-character-equipment-link"
                                            type="button"
                                            data-item-id="{{id}}"
                                            title="Ouvrir la fiche"
                                        >

                                            <img
                                                class="metro-character-equipment-image"
                                                src="{{img}}"
                                                alt="{{name}}"
                                            >

                                            <span class="metro-character-equipment-name">
                                                {{name}}
                                            </span>

                                        </button>

                                    </td>

                                    <td class="metro-character-equipment-cell-weight">
                                        {{weight}}
                                    </td>

                                    <td class="metro-character-equipment-cell-info">

                                        {{#if conditionLabel}}
                                            <span class="metro-character-equipment-condition">
                                                {{conditionLabel}}
                                            </span>
                                        {{/if}}

                                        {{#if quantityLabel}}
                                            <span class="metro-character-equipment-quantity">
                                                {{quantityLabel}}
                                            </span>
                                        {{/if}}

                                        {{#if stackable}}

                                            <div class="metro-character-equipment-stepper">

                                                <button
                                                    type="button"
                                                    class="metro-character-equipment-stepper-button"
                                                    data-action="decrement"
                                                    data-item-id="{{id}}"
                                                    title="Diminuer d'une unité"
                                                    aria-label="Diminuer la quantité de {{name}}"
                                                >
                                                    −
                                                </button>

                                                <button
                                                    type="button"
                                                    class="metro-character-equipment-stepper-button"
                                                    data-action="increment"
                                                    data-item-id="{{id}}"
                                                    title="Augmenter d'une unité"
                                                    aria-label="Augmenter la quantité de {{name}}"
                                                >
                                                    +
                                                </button>

                                            </div>

                                        {{/if}}

                                    </td>

                                    <td class="metro-character-equipment-cell-equipped">

                                        {{#if canToggleEquipped}}

                                            <input
                                                type="checkbox"
                                                class="metro-character-equipment-equipped-checkbox"
                                                data-item-id="{{id}}"
                                                {{#if equipped}}checked{{/if}}
                                                {{#unless @root.editable}}disabled{{/unless}}
                                                title="Équipée pour le Combat"
                                                aria-label="{{name}} équipée pour le Combat"
                                            />

                                        {{/if}}

                                    </td>

                                    <td class="metro-character-equipment-cell-actions">

                                        <button
                                            class="metro-character-item-actions"
                                            type="button"
                                            data-item-id="{{id}}"
                                            data-item-type="{{type}}"
                                            title="Actions"
                                            aria-label="Actions pour {{name}}"
                                            aria-haspopup="menu"
                                        >
                                            ⋮
                                        </button>

                                    </td>

                                </tr>

                            {{/each}}

                        </tbody>

                    </table>

                {{else}}

                    <div class="metro-character-equipment-empty">
                        Aucun objet de ce type.
                    </div>

                {{/if}}

            </section>

        {{/each}}

    </section>


    <!-- ===================================================== -->
    <!-- SURVIE                                                -->
    <!-- ===================================================== -->

    <section
        class="metro-character-survival metro-character-tab-panel"
        data-character-tab-panel="survival"
        role="tabpanel"
        hidden
    >

        <!-- ============================================= -->
        <!-- EN-TÊTE : STRESS + SANG-FROID                 -->
        <!-- ============================================= -->

        <section class="metro-character-survival-summary">

            <label class="metro-character-survival-stress">
                <span>
                    <span class="metro-red-star" aria-hidden="true">★</span>
                    <span>Stress (dés)</span>
                </span>

                <input
                    type="number"
                    name="system.stress.dice"
                    value="{{character.survival.stress.dice}}"
                    min="0"
                    max="5"
                    step="1"
                    {{#unless editable}}disabled{{/unless}}
                />
            </label>

            <label class="metro-character-survival-composure">
                <span>
                    <span class="metro-red-star" aria-hidden="true">★</span>
                    <span>Sang-froid</span>
                </span>

                <input
                    type="number"
                    name="system.stress.composure.current"
                    value="{{character.survival.composure.current}}"
                    min="0"
                    max="{{character.survival.composure.max}}"
                    step="1"
                    {{#unless editable}}disabled{{/unless}}
                />
                <span class="metro-character-survival-composure-max">
