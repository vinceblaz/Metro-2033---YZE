                >
                    <i class="fa-solid fa-biohazard" aria-hidden="true"></i>
                    <span>Effets des radiations</span>
                </button>

            </div>

        </section>


        <!-- ============================================= -->
        <!-- ÉTATS                                         -->
        <!-- ============================================= -->

        <section class="metro-character-survival-panel">

            <div class="metro-item-section-header metro-character-survival-section-header">
                <span class="metro-red-star" aria-hidden="true">★</span>
                <span>États</span>
            </div>

            <div class="metro-character-survival-conditions metro-character-survival-states-grid">

                {{#each character.survival.conditions}}

                    <label class="metro-character-survival-condition">
                        <input
                            type="checkbox"
                            name="system.conditions.{{key}}"
                            {{#if active}}checked{{/if}}
                            {{#unless @root.editable}}disabled{{/unless}}
                        />
                        <span>{{label}}</span>
                    </label>

                {{/each}}

            </div>

            {{#if character.survival.statusEffects.length}}

                <div class="metro-character-survival-status-effects-header">
